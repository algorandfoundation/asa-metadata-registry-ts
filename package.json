{
  "name": "@algorandfoundation/asa-metadata-registry-sdk",
  "version": "0.1.0",
  "description": "ASA Metadata Registry TypeScript SDK",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./avm": "./src/generated/avm/AsaMetadataRegistry.client.ts"
  },
  "typesVersions": {
    "*": {
      "avm": [
        "./src/generated/avm/AsaMetadataRegistry.client.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src/generated/avm"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:dist-pkg": "node scripts/write-dist-package-json.mjs",
    "build": "pnpm run build:cjs && pnpm run build:esm && pnpm run build:dist-pkg",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:avm-client": "mkdir -p src/generated/avm && puyats-clientgen arc89/smart_contracts/artifacts/asa_metadata_registry/AsaMetadataRegistry.arc56.json --out-dir ../../../../src/generated/avm",
    "check:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/asa-metadata-registry-ts.git"
  },
  "author": "Algorand Foundation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/algorandfoundation/asa-metadata-registry-ts/issues"
  },
  "homepage": "https://github.com/algorandfoundation/asa-metadata-registry-ts#readme",
  "devDependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.2",
    "@algorandfoundation/puya-ts": "^1.3.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.11",
    "algosdk": "^3.8.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.2",
    "algosdk": "^3.8.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "release": {
    "branches": [
      {
        "name": "main",
        "prerelease": "beta"
      },
      {
        "name": "release"
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "build",
                "section": "Dependencies and Other Build Updates",
                "hidden": false
              },
              {
                "type": "refactor",
                "section": "Code Refactoring"
              }
            ]
          }
        }
      ],
      [
        "@semantic-release/npm",
        {
          "provenance": true
        }
      ],
      "@semantic-release/github"
    ]
  }
}
